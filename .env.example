# IT for Society - Deployment Configuration
# Copy to .env and customize for your deployment

# Domain Configuration
DOMAIN=itforsociety.com
ENVIRONMENT=production

# Application
NODE_ENV=production
PORT=4200
REBUILD_CACHE=1

# SSL/TLS
LETSENCRYPT_EMAIL=admin@itforsociety.com
LETSENCRYPT_AUTO_RENEW=true

# Nginx
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# Docker
DOCKER_IMAGE_NAME=itforsociety
DOCKER_IMAGE_TAG=latest

# Optional: For Docker Registry (if pushing to registry)
# DOCKER_REGISTRY_URL=docker.io
# DOCKER_USERNAME=your-username
# DOCKER_PASSWORD=your-password
